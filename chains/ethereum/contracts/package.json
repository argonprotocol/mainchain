{
  "name": "@argonprotocol/ethereum-contracts",
  "version": "1.5.2",
  "private": true,
  "type": "module",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./generated": {
      "types": "./generated.ts",
      "default": "./generated.ts"
    },
    "./hashing": {
      "types": "./hashing.ts",
      "default": "./hashing.ts"
    },
    "./fixtures": {
      "types": "./fixtures.ts",
      "default": "./fixtures.ts"
    }
  },
  "scripts": {
    "build": "hardhat compile && wagmi generate",
    "codegen": "wagmi generate",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "lint:sol:fix": "solhint --fix 'contracts/**/*.sol'",
    "tsc": "yarn build",
    "tsup": "yarn build",
    "typecheck": "yarn build && tsc --noEmit",
    "pretest": "yarn build",
    "pretest:ci": "yarn build",
    "test": "yarn pretest && yarn --cwd ../../.. exec vitest --run --config vitest.config.ts --project ethereum-contracts"
  },
  "devDependencies": {
    "@ethereumjs/mpt": "^10.1.1",
    "@nomicfoundation/hardhat-ethers": "4.0.10",
    "@openzeppelin/contracts": "^5.4.0",
    "@openzeppelin/contracts-upgradeable": "^5.4.0",
    "@types/node": "22.17.1",
    "@uniswap/permit2": "https://github.com/Uniswap/permit2/archive/cc56ad0f3439c502c246fc5cfcc3db92bb8b7219.tar.gz",
    "@uniswap/universal-router": "https://github.com/Uniswap/universal-router/archive/802fe4c18f47300e0f183e2a42e9146ec2ea9fc3.tar.gz",
    "@uniswap/v3-core": "1.0.2-solc-0.8-simulate",
    "@uniswap/v4-core": "1.0.2",
    "@uniswap/v4-periphery": "patch:@uniswap/v4-periphery@https%3A//github.com/Uniswap/v4-periphery/archive/545a5d2a87228167edde48f3b9eda122d1e3c4d6.tar.gz#~/.yarn/patches/@uniswap-v4-periphery-https-a69d333e68.patch",
    "@wagmi/cli": "^2.10.0",
    "ethers": "^6.15.0",
    "hardhat": "^3.18.1",
    "solhint": "^6.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "viem": "^2.38.5"
  },
  "packageManager": "yarn@4.1.1"
}
