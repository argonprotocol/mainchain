{
  "name": "@argonprotocol/ethereum-deploy",
  "version": "1.5.2",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap:deploy": "node --import tsx index.ts",
    "bootstrap:prepare-runtime-setup": "node --import tsx prepareRuntimeSetup.ts",
    "build": "yarn workspace @argonprotocol/ethereum-contracts build && tsc --noEmit",
    "etherscan:output-files": "node --import tsx outputEtherscanFiles.ts",
    "gas:measure": "node --import tsx measure.ts",
    "gateway-backfill:prepare": "node --import tsx prepareGatewayBackfills.ts",
    "prepare:gateway-upgrade": "node --import tsx prepareMintingGatewayUpgrade.ts",
    "pretest": "yarn build",
    "pretest:ci": "yarn build",
    "runtime-pricing:prepare": "node --import tsx prepareRuntimePricing.ts",
    "runtime-setup:prepare": "node --import tsx prepareRuntimeSetup.ts",
    "stabilization:prepare": "node --import tsx deployStabilizationPool.ts",
    "stabilization:publish": "node --import tsx deployStabilizationPool.ts --publish",
    "tsc": "yarn build",
    "tsup": "yarn build",
    "typecheck": "yarn build"
  },
  "dependencies": {
    "@argonprotocol/ethereum-contracts": "workspace:*",
    "@argonprotocol/mainchain": "workspace:*",
    "@nomicfoundation/hardhat-ethers": "4.0.10",
    "ethers": "^6.15.0",
    "hardhat": "^3.18.1",
    "viem": "^2.38.5"
  },
  "devDependencies": {
    "@types/node": "22.17.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "packageManager": "yarn@4.10.3"
}
